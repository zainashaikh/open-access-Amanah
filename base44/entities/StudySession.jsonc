{
  "name": "StudySession",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "place_id": {
      "type": "string"
    },
    "place_name": {
      "type": "string"
    },
    "place_address": {
      "type": "string"
    },
    "scheduled_for": {
      "type": "string"
    },
    "max_attendees": {
      "type": "number",
      "default": 4
    },
    "note": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open"
    }
  },
  "required": [
    "user_id",
    "place_id",
    "place_name",
    "scheduled_for"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
